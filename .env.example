# Copy to .env.local for local web use, or .env for CLI / container services.
# Never put secrets in NEXT_PUBLIC_* variables. Never paste keys into chat.
APP_MODE=unconfigured
DEPLOYMENT_ENV=local
SITE_URL=http://localhost:3000
# PostgreSQL (pg for containers; neon for Sites HTTPS database access)
DATABASE_DRIVER=pg
DATABASE_URL=
# Direct connection for migrations using session-level advisory locks.
DATABASE_URL_UNPOOLED=
TMDB_READ_ACCESS_TOKEN=
SAA_ACCESS_MODE=direct
SAA_API_KEY=
# Use RAPIDAPI_KEY instead of SAA_API_KEY only with SAA_ACCESS_MODE=rapidapi.
RAPIDAPI_KEY=
SUPPORTED_LOCALES=de,fr,it,es,en
ENABLED_MARKETS=de,fr,it,es
# Actual plan units, not guessed request counts. Zero keeps synchronization off.
SAA_DAILY_BUDGET=0
SAA_MONTHLY_BUDGET=0
SAA_ENDPOINT_WEIGHT=1
TMDB_DAILY_BUDGET=500
BUDGET_BUFFER=0.2
SYNC_ENABLED=false
STALE_HOURS=72
# At least 24 / 32 random characters. Generate locally, store as secrets.
ADMIN_KEY=
SESSION_SECRET=
CRON_SECRET=
OPERATOR_NAME=
OPERATOR_ADDRESS=
CONTACT_EMAIL=
LEGAL_APPROVED=false
LICENSES_CONFIRMED=false
TRANSLATION_URL=
TRANSLATION_KEY=
TRANSLATION_RIGHTS_CONFIRMED=false

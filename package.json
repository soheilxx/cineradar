{
  "name": "cineradar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "dev:node": "next dev --hostname 127.0.0.1",
    "build:node": "npm run i18n:check && next build",
    "start:node": "next start",
    "typecheck": "tsc --noEmit",
    "i18n:check": "tsx scripts/validate-i18n.ts",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/cli.ts migrate",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/cli.ts worker",
    "import:dry": "node --env-file-if-exists=.env --import tsx scripts/cli.ts bootstrap --dry-run",
    "import:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/cli.ts bootstrap",
    "import:catalog": "node --env-file-if-exists=.env --import tsx scripts/cli.ts catalog",
    "import:drain": "node --env-file-if-exists=.env --import tsx scripts/drain.ts",
    "budget:estimate": "node --env-file-if-exists=.env --import tsx scripts/cli.ts budget",
    "db:backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts backup",
    "db:restore": "node --env-file-if-exists=.env --import tsx scripts/backup.ts restore"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@neondatabase/serverless": "1.1.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "intl-messageformat": "11.2.14",
    "kysely": "0.29.5",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "sharp": "0.35.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260906.1",
    "@electric-sql/pglite": "0.5.8",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "lighthouse": "13.4.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
